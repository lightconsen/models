[Unit]
Description=kiwano models — daily price sync (HK observation point)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/kiwano-sync.env
# ${REPO_DIR} expands from the env file, so one unit serves any clone location.
ExecStart=/bin/bash ${REPO_DIR}/scripts/sync-hk.sh
